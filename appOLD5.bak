}

# ===================================================================
# CONTINENT — Données pour les cartes calculées (shapefile + BDD_CLEAN.csv)
# Les fonctions load_*() et compute_*_map() / plot_continent_choropleth()
# sont définies dans R/20_continent_maps.R (déjà sourcé à ce stade).
# ===================================================================

# Table de correspondance Region (nom anglais, comme dans BDD_CLEAN.csv et fact$Region)
# -> code(s) ISO_3 pour la jointure avec le fond de carte. Une Region peut
# pointer vers PLUSIEURS ISO_3 (ex: "North and South Sudan").
# ⚠️ Vérifiez cette liste par rapport à unique(fact$Region) / au message
# "Region(s) sans correspondance ISO_3" affiché en console au démarrage.
REGION_TO_ISO3 <- list(
  "Senegal"="SEN","Ivory Coast"="CIV","Ethiopia"="ETH","Morocco"="MAR","South Africa"="ZAF",
  "Tanzania"="TZA","Nigeria"="NGA","Tunisia"="TUN","Algeria"="DZA","Angola"="AGO",
  "Benin"="BEN","Botswana"="BWA","Burkina Faso"="BFA","Cameroon"="CMR","Chad"="TCD",
  "Egypt"="EGY","Gambia"="GMB","Ghana"="GHA","Guinea"="GIN","Kenya"="KEN","Mali"="MLI",
  "Mozambique"="MOZ","Namibia"="NAM","Niger"="NER",
  "North and South Sudan"=c("SDN","SSD"),
  "Rwanda"="RWA","Zambia"="ZMB","Zimbabwe"="ZWE","Burundi"="BDI",
  "Central African Republic"="CAF","Comoros"="COM","Congo"="COG","Djibouti"="DJI",
  "Eswatini"="SWZ","Gabon"="GAB","Guinea-Bissau"="GNB","Lesotho"="LSO","Liberia"="LBR",
  "Libya"="LBY","Malawi"="MWI","Mauritania"="MRT","Sierra Leone"="SLE","Togo"="TGO",
  "Uganda"="UGA","Democratic Republic of the Congo"="COD","United Republic of Tanzania"="TZA"
)

# ⚠️ Adaptez ces 2 chemins si vos fichiers ne sont pas à cet emplacement.
SHAPEFILE_PATH  <- "ne_10m_admin_0_countries.shp"
BDD_CLEAN_PATH  <- file.path("data_raw", "BDD_CLEAN.csv")

continent_shp <- tryCatch(
  load_continent_shapefile(SHAPEFILE_PATH),
  error = function(e) {
    message("Impossible de charger le shapefile continent : ", conditionMessage(e))
    NULL
  }
)

bdd_clean <- tryCatch(
  load_bdd_clean(BDD_CLEAN_PATH, region_to_iso3 = REGION_TO_ISO3),
  error = function(e) {
    message("Impossible de charger BDD_CLEAN.csv : ", conditionMessage(e))
    NULL
  }
)

