  list(nm="pop2018_dict", x=pop2018_dict),
  list(nm="pop2050_dict", x=pop2050_dict),
  list(nm="area_km2_dict", x=area_km2_dict),
  list(nm="flag_iso2_dict", x=flag_iso2_dict)
